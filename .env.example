# Copy to .env to override the defaults.
# Vite only exposes variables prefixed with VITE_.

# Base path for the deployment. GitHub Pages uses /Recipe-98/ by default.
# Cloudflare Pages (domain root) should set VITE_BASE_PATH=/
# VITE_BASE_PATH=/Recipe-98/

# TheMealDB public test key. Replace it if you have a paid key.
VITE_MEALDB_API_KEY=1

# Optional: override the full API base (including the version/key segment).
# VITE_MEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1
