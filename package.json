{
  "name": "recipe-98",
  "private": true,
  "version": "3.0.0",
  "description": "A Windows 98–styled recipe browser powered by TheMealDB.",
  "author": "AuZanPs",
  "license": "MIT",
  "homepage": "https://auzanps.github.io/Recipe-98/",
  "repository": {
    "type": "git",
    "url": "https://github.com/AuZanPs/Recipe-98.git"
  },
  "bugs": {
    "url": "https://github.com/AuZanPs/Recipe-98/issues"
  },
  "keywords": [
    "astro",
    "react",
    "typescript",
    "windows-98",
    "98.css",
    "recipes",
    "themealdb"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run typecheck && astro build",
