---
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Recipe Discovery 98',
  description = 'A retro 98-styled recipe browser powered by TheMealDB.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path}`;
---

<!doctype html>
<html
  lang="en"
  data-theme="standard"
  style={`--recipe-placeholder:url('${asset('recipe-placeholder.svg')}')`}
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={asset('site.webmanifest')} />
    <link rel="preconnect" href="https://www.themealdb.com" crossorigin />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#008080" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <noscript>Recipe Discovery 98 requires JavaScript to run.</noscript>
  </body>
</html>
